# DataVault Configuration Example
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true

# Database - Simulated Operator
DATABASE_URL=postgresql://datavault:datavault_operator_password@localhost:5436/datavault_operator

# JWT Keys (RSA keys for RS256 signing)
# Generate with: openssl genrsa -out private.pem 2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRY_HOURS=720

# Backend Database
BACKEND_DATABASE_URL=postgresql://datavault:datavault_backend_password@localhost:5437/datavault_backend

# Redis
REDIS_URL=redis://localhost:6381/0

# API URLs
OPERATOR_API_URL=http://localhost:8001
DATAVAULT_BACKEND_URL=http://localhost:8000
DEVICE_SIMULATOR_URL=http://localhost:8002

# Device
DEVICE_ID=DV-001-ABCD
DATAVAULT_BACKEND_URL=http://localhost:8000
